{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crimson ScreenLive",
  "version": "0.7.0",
  "identifier": "com.crimson.screenlive",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run vite:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Crimson ScreenLive",
        "width": 440,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"]
      }
    },
    "shortDescription": "Transmissão de tela entre amigos",
    "publisher": "Crimson",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2ODE1NDczMEQxRDVEMTIKUldRU1hSME5jMVNCVnBWR2l5WDhjWHlKVGJOanEwWmpkY2JPdEs5Zk5FZHJYRzloVlp5akpPaU0K",
      "endpoints": [
        "https://github.com/LucasWinner/crimson-screenlive/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
